<Window x:Class="SecureFileVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Encryptor" Height="350" Width="500"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Margin="10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Drag &amp; Drop a file, or click Browse:" Margin="0,0,0,10"/>
            <TextBox x:Name="FilePathTextBox" Height="25" Margin="0,0,0,10" IsReadOnly="True"/>

            <TextBlock Text="Password:"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5" PasswordChanged="PasswordBox_PasswordChanged"/>
            <ProgressBar x:Name="PasswordStrengthBar" Height="10" Margin="0,0,0,10" Maximum="100"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Browse" Click="BrowseButton_Click" Width="100" Margin="5"/>
                <Button Content="Encrypt" Click="EncryptButton_Click" Width="100" Margin="5"/>
                <Button Content="Decrypt" Click="DecryptButton_Click" Width="100" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
